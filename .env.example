# Ninja Labs NFT Deployment Configuration
# Copy this file to .env and fill in your values

# ============ Network Configuration ============
# Injective Testnet RPC
TESTNET_RPC_URL=https://testnet.sentry.chain.json-rpc.injective.network

# Injective Mainnet RPC
MAINNET_RPC_URL=https://injectiveevm-rpc.polkachu.com

# Block Explorer API Key (for verification)
EXPLORER_API_KEY=your_api_key_here

# ============ Deployer Configuration ============
# Private key for deployment (WITHOUT 0x prefix)
PRIVATE_KEY=your_private_key_here

# ============ Contract Configuration ============

# NFT Supply Configuration
MAX_SUPPLY=200
MAX_PER_WALLET=5

# Mint Price (in wei, 1 INJ = 1000000000000000000 wei)
MINT_PRICE=1000000000000000000

# Metadata Configuration
BASE_URI=https://api.ninjalabs.xyz/metadata/

# Tier Thresholds (points required for upgrades)
TIER1_THRESHOLD=100  # PURPLE tier
TIER2_THRESHOLD=500  # ORANGE tier

# ============ Role Addresses ============
# Leave empty to use deployer address for all roles (testnet only)

# Oracle address (manages point updates from off-chain system)
ORACLE_ADDRESS=

# Upgrader address (can batch upgrade NFTs)
UPGRADER_ADDRESS=

# Treasury address (can withdraw contract funds)
TREASURY_ADDRESS=

# ============ Genesis Contract Configuration ============
# Genesis drop supply and metadata
GENESIS_MAX_SUPPLY=1000
GENESIS_BASE_URI=https://api.ninjalabs.xyz/genesis/

# ============ Deployment Notes ============
#
# Testnet Deployment:
# forge script script/DeployNinjaLabsNFT.s.sol:DeployNinjaLabsNFT --sig "deployTestnet()" --rpc-url $TESTNET_RPC_URL --broadcast -vvvv
#
# Mainnet Deployment:
# forge script script/DeployNinjaLabsNFT.s.sol:DeployNinjaLabsNFT --sig "deployMainnet()" --rpc-url $MAINNET_RPC_URL --broadcast -vvvv
#
# General Deployment (uses env vars or defaults):
# forge script script/DeployNinjaLabsNFT.s.sol:DeployNinjaLabsNFT --rpc-url <RPC_URL> --broadcast -vvvv
#
# Contract Verification:
# forge verify-contract <CONTRACT_ADDRESS> src/NinjaLabsNFT.sol:NinjaLabsNFT --chain-id <CHAIN_ID> --constructor-args <ARGS>
